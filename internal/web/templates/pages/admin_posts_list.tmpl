{{ define "pages/admin_posts_list.tmpl" }}
  {{ template "partials/header" . }}
  <div class="admin-header">
    <div class="tabs">
      <a class="tab active" href="/admin/posts">文章列表</a>
      <a class="tab" href="/admin/posts/new">新建文章</a>
    </div>
  </div>
  <div class="admin-table-wrap">
    <div class="table-responsive">
    <table class="table">
    <thead>
      <tr><th>标题</th><th>发布时间</th><th class="actions">操作</th></tr>
    </thead>
    <tbody>
      {{ range .Posts }}
      <tr>
        <td class="title"><a href="/admin/posts/{{ .ID }}/edit">{{ .Title }}</a></td>
        <td class="date">{{ if .PublishedAt.IsZero }}-{{ else }}{{ .PublishedAt.Format "2006-01-02 15:04" }}{{ end }}</td>
        <td class="actions">
          <a class="btn btn-secondary btn-sm" href="/admin/posts/{{ .ID }}/edit">编辑</a>
          <form method="post" action="/admin/posts/{{ .ID }}/delete" class="inline-form" onsubmit="return confirm('确认删除？');">
            <input type="hidden" name="_csrf" value="{{ $.CSRFToken }}">
            <button class="btn btn-danger btn-sm" type="submit">删除</button>
          </form>
        </td>
      </tr>
      {{ end }}
    </tbody>
    </table>
    </div>
  </div>
  {{ if gt .Pager.TotalPages 1 }}
  <div class="paginator">
    {{ if .Pager.PrevURL }}<a class="prev" href="{{ .Pager.PrevURL }}">上一页</a>{{ end }}
    <span class="page-number">第 {{ .Pager.Page }} / {{ .Pager.TotalPages }} 页</span>
    {{ if .Pager.NextURL }}<a class="next" href="{{ .Pager.NextURL }}">下一页</a>{{ end }}
  </div>
  {{ end }}
  {{ template "partials/footer" . }}
{{ end }}
