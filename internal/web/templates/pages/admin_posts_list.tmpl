{{ define "pages/admin_posts_list.tmpl" }}
  {{ template "partials/header" . }}
  <h1>文章管理</h1>
  <p>
    <a href="/admin">返回后台</a>
    · <a href="/admin/posts/new">新建文章</a>
    · <a href="/">查看站点</a>
  </p>
  <table>
    <thead>
      <tr><th>ID</th><th>标题</th><th>Slug</th><th>发布时间</th><th>操作</th></tr>
    </thead>
    <tbody>
      {{ range .Posts }}
      <tr>
        <td>{{ .ID }}</td>
        <td>{{ .Title }}</td>
        <td>{{ .Slug }}</td>
        <td>{{ if .PublishedAt.IsZero }}-{{ else }}{{ .PublishedAt.Format "2006-01-02 15:04" }}{{ end }}</td>
        <td>
          <a href="/admin/posts/{{ .ID }}/edit">编辑</a>
          <form method="post" action="/admin/posts/{{ .ID }}/delete" style="display:inline" onsubmit="return confirm('确认删除？');">
            <input type="hidden" name="_csrf" value="{{ $.CSRFToken }}">
            <button type="submit">删除</button>
          </form>
        </td>
      </tr>
      {{ end }}
    </tbody>
  </table>
  {{ if gt .Pager.TotalPages 1 }}
  <div class="paginator">
    {{ if .Pager.PrevURL }}<a class="prev" href="{{ .Pager.PrevURL }}">上一页</a>{{ end }}
    <span class="page-number">第 {{ .Pager.Page }} / {{ .Pager.TotalPages }} 页</span>
    {{ if .Pager.NextURL }}<a class="next" href="{{ .Pager.NextURL }}">下一页</a>{{ end }}
  </div>
  {{ end }}
  {{ template "partials/footer" . }}
{{ end }}
