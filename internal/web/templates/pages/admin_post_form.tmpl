{{ define "pages/admin_post_form.tmpl" }}
  {{ template "partials/header" . }}
  <div class="admin-header">
    <div class="tabs">
      {{ if eq .Title "新建文章" }}
        <a class="tab" href="/admin/posts">文章列表</a>
        <a class="tab active" href="/admin/posts/new">新建文章</a>
      {{ else }}
        <a class="tab active" href="/admin/posts">文章列表</a>
        <a class="tab" href="/admin/posts/new">新建文章</a>
      {{ end }}
    </div>

  </div>
  <div class="card admin-card">
    <form method="post" action="{{ .Action }}" class="form">
      <input type="hidden" name="_csrf" value="{{ .CSRFToken }}">
      <div class="form-group">
        <label>标题</label>
        <input type="text" name="title" value="{{ .Post.Title }}" required>
      </div>
      <div class="form-group">
        <label>Slug</label>
        <input type="text" name="slug" value="{{ .Post.Slug }}" placeholder="留空自动生成">
      </div>
      <div class="form-group">
        <label>分类</label>
        <select name="category">
          <option value="">（无分类）</option>
          {{ range .Categories }}
            <option value="{{ .Slug }}" {{ if eq $.SelectedCategory .Slug }}selected{{ end }}>{{ .Name }}</option>
          {{ end }}
        </select>
      </div>
      <div class="form-group">
        <label>标签（逗号分隔）</label>
        <input type="text" name="tags" value="{{ .TagsCSV }}" placeholder="例如：Go, 数据库, 学习">
      </div>
      <div class="form-group">
        <label>摘要</label>
        <textarea name="summary" rows="3">{{ .Post.Summary }}</textarea>
      </div>
      <div class="form-group">
        <label>内容（Markdown）</label>
        <textarea name="content_md" rows="16">{{ .Post.ContentMD }}</textarea>
      </div>
      <div class="form-group">
        <label>状态</label>
        <select name="status">
          <option value="draft">草稿</option>
          <option value="published">发布</option>
        </select>
      </div>
      <div class="form-group">
        <label>发布时间(可选，格式 2006-01-02 15:04)</label>
        <input type="text" name="published_at" value="{{ if not .Post.PublishedAt.IsZero }}{{ .Post.PublishedAt.Format "2006-01-02 15:04" }}{{ end }}" placeholder="例如：2006-01-02 15:04">
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">保存</button>
      </div>
    </form>
  </div>
  {{ template "partials/footer" . }}
{{ end }}
